<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Windows-Installer für Agent (Dienst) und Tray-App. Bauen mit installer/build.ps1. -->
  <PropertyGroup>
    <OutputName>YubikeyLifecycleManager-Agent</OutputName>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)publish\</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
    <!-- Bekannte Fehlmeldungen bei perMachine-Paketen mit Startmenü-Verknüpfung (ProgramMenuFolder gilt bei der Validierung als Benutzerprofil). -->
    <SuppressIces>ICE38;ICE43;ICE57</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>
</Project>
