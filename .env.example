# Kopieren nach .env und anpassen.
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort
YLM_PUBLIC_URL=https://ylm.example.com

# Version des Server-Images (Standard: neueste Version).
# YLM_VERSION=latest

# Update per Klick in der Oberfläche: langes Zufalls-Geheimnis, z. B. `openssl rand -hex 32`.
# Leer lassen, um den Updater-Container abzuschalten.
UPDATER_TOKEN=
