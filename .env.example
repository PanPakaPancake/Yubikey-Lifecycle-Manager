# Einstellungen der Installation. Das Installationsskript (install.sh / install.ps1) legt .env mit
# Zufallsgeheimnissen an. Von Hand: nach .env kopieren und die Werte ersetzen.
# Nach einer Änderung: docker compose up -d

# Fester Name der Installation in Docker (Container, Volumes). Bei bestehenden Installationen nicht ändern,
# sonst startet Docker mit leeren Volumes.
# COMPOSE_PROJECT_NAME=ylm

# Datenbank-Passwort, z. B. `openssl rand -hex 24`. Nach der ersten Installation nicht mehr ändern.
POSTGRES_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# Öffentliche Adresse, unter der Browser und Agents die Plattform erreichen.
# Lokal auf dem eigenen PC: http://localhost:8080 (http geht nur mit localhost). Sonst immer https://.
YLM_PUBLIC_URL=http://localhost:8080

# Gewählter Betriebsmodus (nur zur Information, setzt install.sh/install.ps1):
# internal, cert, proxy, https oder local. Umstellen: Installationsskript mit --mode bzw. -Mode erneut ausführen.
# YLM_MODE=internal

# --- HTTPS über den mitgelieferten Caddy (COMPOSE_PROFILES=https) ---
# Gedacht für internes Netz oder ZTNA. YLM_DOMAIN ist der DNS-Name, unter dem die Admin-PCs die Plattform
# erreichen, YLM_PUBLIC_URL=https://<YLM_DOMAIN>. YLM_CADDY_TLS wählt das Zertifikat:
#   tls internal                        interne Zertifizierungsstelle von Caddy; das Stammzertifikat
#                                       (ylm-root-ca.crt) per GPO/Intune auf den Admin-PCs verteilen
#   tls /certs/ylm.crt /certs/ylm.key   eigenes Zertifikat (Firmen-PKI) aus dem Ordner certs/
#   (leer)                              Let's Encrypt; nur wenn der Server aus dem Internet erreichbar ist
# COMPOSE_PROFILES=https
# YLM_DOMAIN=ylm.firma.local
# YLM_CADDY_TLS=tls internal
# Adresse, auf der Caddy die Ports 80/443 öffnet (Standard alle). Z. B. nur die interne Schnittstelle: 10.0.0.5
# YLM_HTTPS_BIND=0.0.0.0

# --- Eigener Reverse Proxy oder ZTNA-Connector ---
# Wo der Server-Port 8080 lauscht. Standard nur lokal (127.0.0.1:8080). Läuft der Proxy auf einem anderen
# Rechner, die interne Adresse dieses Servers, z. B. 10.0.0.5:8080. Niemals ungeschützt ins Internet.
# YLM_BIND=127.0.0.1:8080
# Forwarded-Header (Client-IP für Audit-Log und Anmeldebremse) übernimmt der Server nur von privaten Netzen.
# Kommt der Proxy/Connector von einer anderen Adresse: Komma-Liste von IPs oder Netzen. "*" = allen glauben.
# YLM_TRUSTED_PROXIES=203.0.113.10, 2001:db8::/32

# Update per Klick in der Oberfläche: langes Zufalls-Geheimnis, z. B. `openssl rand -hex 32`.
# Leer lassen, um den Updater abzuschalten.
UPDATER_TOKEN=

# Version des Server-Images festhalten (Standard: neueste Version).
# YLM_VERSION=latest

# Datensicherung (Dienst "backup"): Uhrzeit HH:MM oder off, Aufbewahrung in Tagen, Zielordner.
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups
# Passphrase für die Verschlüsselung der Sicherungen (AES-256). Legt das Installationsskript an.
# Zusätzlich im Passwortmanager ablegen: Ohne sie lässt sich keine Sicherung einspielen. Leer = unverschlüsselt.
BACKUP_PASSPHRASE=

# App-Zertifikat (Anmeldung der Plattform in allen Tenants) 30 Tage vor dem Ablauf selbst erneuern.
# false = nur warnen (Übersicht, Audit-Log, Webhooks/Mail-Alarme), Erneuerung dann von Hand.
# YLM_CERT_AUTO_RENEW=true

# Anmeldung der Admins per Entra nur mit Sicherheitsschlüssel/Passkey. Nur für Tests abschalten.
# YLM_REQUIRE_PHISHING_RESISTANT=true

# Zeitzone für Protokolle, Mail-Berichte und Sicherungen.
# TZ=Europe/Berlin
